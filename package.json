{
  "name": "rl-league",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "DATABASE_URL=\"$QA_DATABASE_URL\" node scripts/migrate.mjs && DATABASE_URL=\"$QA_DATABASE_URL\" tsx --conditions=react-server tests/integration.ts && next build",
    "start": "next start",
    "migrate": "node scripts/migrate.mjs",
    "test": "node --test tests/engine.test.ts",
    "typecheck": "tsc --noEmit",
    "test:integration": "tsx --conditions=react-server tests/integration.ts",
    "i18n": "node scripts/i18n-build.mjs",
    "i18n:check": "node scripts/i18n-build.mjs --check"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.0",
    "bcryptjs": "^3.0.2",
    "jose": "^6.0.0",
    "next": "^15.5.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.6.0",
    "tsx": "^4.19.0"
  },
  "engines": {
    "node": "22.x"
  }
}
